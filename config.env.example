# API Keys & Configuration
# Copy this to config.env and fill in your actual keys

# LLM API (for generating rhymes)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# TTS Service
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Stock images
PEXELS_API_KEY=your_pexels_key_here

# YouTube API (future)
YOUTUBE_API_KEY=your_youtube_key_here

# Google Drive (for auto-syncing videos)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=./service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Telegram (future notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Local Settings
OUTPUT_DIR=./output
STAGING_DIR=./output/staging
ARCHIVE_DIR=./output/uploaded
LOG_DIR=./logs

# Daily schedule (24-hour format UTC)
DAILY_JOB_TIME=06:00

# Number of video pairs per day
VIDEOS_PER_DAY=5
