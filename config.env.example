# API Keys & Configuration
# Copy this to config.env and fill in your actual keys

# LLM API (for generating rhymes)
OPENAI_API_KEY=your_key_here
# OR use Claude:
ANTHROPIC_API_KEY=your_key_here

# TTS Service (choose one)
ELEVENLABS_API_KEY=your_key_here
# OR Google Cloud TTS:
GOOGLE_TTS_CREDENTIALS_JSON=path/to/credentials.json

# YouTube API (for upload notifications)
YOUTUBE_API_KEY=your_key_here

# Pexels/Pixabay for stock content
PEXELS_API_KEY=your_key_here
PIXABAY_API_KEY=your_key_here

# (Optional) Replicate for AI image generation
REPLICATE_API_TOKEN=your_key_here

# Telegram (later, for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Google Drive (for content storage)
GOOGLE_DRIVE_FOLDER_ID=your_folder_id
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Local Settings
OUTPUT_DIR=./output
STAGING_DIR=./output/staging
ARCHIVE_DIR=./output/uploaded
LOG_DIR=./logs

# Daily schedule (24-hour format)
# When to run daily generation job (e.g., 06:00 for 6 AM)
DAILY_JOB_TIME=06:00

# Number of videos to generate per day
VIDEOS_PER_DAY=5
